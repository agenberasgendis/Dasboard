{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Katalog produk beras dan sembako di toko Agen Beras Gendis",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sku": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 80 },
        "unit": { "type": "string", "maxLength": 30 },
        "stock": { "type": "number" },
        "minStock": { "type": "number" },
        "costPrice": { "type": "number" },
        "sellPrice": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "category", "unit", "stock", "costPrice", "sellPrice"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Data transaksi penjualan kasir toko",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string", "maxLength": 50 },
        "date": { "type": "string" },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "totalAmount": { "type": "number" },
        "totalProfit": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["TUNAI", "TRANSFER", "TEMPO"] },
        "paymentStatus": { "type": "string", "enum": ["LUNAS", "BELUM_LUNAS"] },
        "operatorName": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "invoiceNumber", "date", "customerName", "totalAmount", "paymentMethod", "paymentStatus"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Data transaksi kulakan dan pembelian barang masuk dari distributor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string", "maxLength": 50 },
        "date": { "type": "string" },
        "supplierName": { "type": "string", "maxLength": 120 },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["TUNAI", "TRANSFER", "TEMPO"] },
        "operatorName": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "invoiceNumber", "date", "supplierName", "totalAmount", "paymentMethod"]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Catatan riwayat mutasi stok masuk dan keluar",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string", "maxLength": 150 },
        "type": { "type": "string", "enum": ["IN", "OUT", "ADJUST"] },
        "quantity": { "type": "number" },
        "unit": { "type": "string", "maxLength": 30 },
        "unitCostPrice": { "type": "number" },
        "unitSellPrice": { "type": "number" },
        "totalAmount": { "type": "number" },
        "profit": { "type": "number" },
        "date": { "type": "string" },
        "referenceId": { "type": "string", "maxLength": 60 },
        "referenceType": { "type": "string", "enum": ["SALE", "PURCHASE", "MANUAL"] },
        "operatorName": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "productId", "productName", "type", "quantity", "unit", "date"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Catatan pengeluaran operasional toko",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string", "maxLength": 80 },
        "amount": { "type": "number" },
        "description": { "type": "string", "maxLength": 300 },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "operatorName": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "date", "category", "amount", "description"]
    },
    "StoreConfig": {
      "title": "StoreConfig",
      "description": "Informasi profil dan pengaturan toko",
      "type": "object",
      "properties": {
        "storeName": { "type": "string", "maxLength": 150 },
        "address": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 50 },
        "receiptFooter": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string" }
      },
      "required": ["storeName", "address", "phone"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Koleksi data master produk sembako dan beras"
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Koleksi transaksi penjualan toko"
    },
    "/purchases/{purchaseId}": {
      "schema": "Purchase",
      "description": "Koleksi transaksi kulakan atau barang masuk"
    },
    "/stockMovements/{movementId}": {
      "schema": "StockMovement",
      "description": "Koleksi catatan arus mutasi stok"
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Koleksi pencatatan beban biaya operasional"
    },
    "/storeConfig/{configId}": {
      "schema": "StoreConfig",
      "description": "Konfigurasi informasi toko dan nota cetak"
    }
  }
}
